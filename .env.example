# =========================================================
# Financial Habit Coach (Bachatt Mitra) Environment Config
# =========================================================

# --- Sarvam AI (Indian Vernacular Voice & STT/TTS) ---
# Portal: https://indus.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai
# Models: saaras:v1 (Speech-to-Text), bulbul:v1 (Text-to-Speech)
SARVAM_STT_MODEL=saaras:v1
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_LANGUAGE_CODE=hi-IN

# --- ElevenLabs API (Ultra-Low Latency Conversational Voice) ---
# Portal: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- OpenAI API (Agentic Intelligence & Orchestration) ---
# Portal: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- Application & Server Settings ---
PORT=8000
HOST=0.0.0.0
SQLITE_DB_PATH=backend/data/bachatt_coach.db
ENVIRONMENT=development
